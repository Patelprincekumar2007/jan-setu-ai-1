# Environment Configuration for NagrikLens AI
# Never commit actual secret keys to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Google Gemini Configuration
# Current official Google GenAI SDK
# Configurable model ID (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Future phases)
DATABASE_URL=sqlite:///./nagriklens.db

# Vector Store / RAG Configuration (Future phases)
CHROMA_DB_PATH=./data/chroma
